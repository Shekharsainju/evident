<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ copy.document_title }}</title>
<style>
  :root { color-scheme: light; --ink: #152439; --muted: #5c6b7d; --accent: #245c82; --line: #dbe5ee; --paper: #fff; }
  * { box-sizing: border-box; }
  @page { size: A4; margin: 15mm 17mm; }
  body { margin: 0; background: #edf2f6; color: var(--ink); font: 10.5pt/1.55 Arial, Helvetica, sans-serif; }
  .profile { max-width: 210mm; margin: 24px auto; padding: 35px 42px 28px; background: var(--paper); box-shadow: 0 7px 28px #18324a15; }
  .profile-header { margin-bottom: 20px; padding-bottom: 21px; border-bottom: 2px solid var(--accent); }
  .profile-header h1 { margin: 0; font-size: 27pt; line-height: 1.15; letter-spacing: -.7px; overflow-wrap: anywhere; }
  .identity-detail { margin: 8px 0 0; color: var(--muted); font-size: 11pt; overflow-wrap: anywhere; }
  .identity-detail:first-of-type { color: var(--accent); font-size: 12pt; font-weight: 600; }
  .profile-section { margin-top: 21px; break-inside: avoid-page; }
  .profile-section h2 { margin: 0 0 10px; padding-bottom: 6px; border-bottom: 1px solid var(--line); color: var(--accent); font-size: 11.5pt; letter-spacing: .06em; text-transform: uppercase; }
  .claims { margin: 0; padding: 0; list-style: none; }
  .claims li { position: relative; margin-bottom: 9px; padding-left: 16px; overflow-wrap: anywhere; }
  .claims li::before { position: absolute; left: 1px; top: .64em; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); content: ""; }
  .claim-link { color: inherit; text-decoration: none; }
  .claim-link:hover { color: var(--accent); text-decoration: underline; }
  footer { margin-top: 25px; padding-top: 11px; border-top: 1px solid var(--line); color: var(--muted); font-size: 8pt; }
  .receipt-popover { width: min(720px, calc(100vw - 32px)); max-height: 80vh; overflow: auto; border: 0; border-radius: 12px; padding: 22px; box-shadow: 0 18px 60px #15243955; } .receipt-popover::backdrop { background: #15243988; } .popover-close { float: right; }
  @media print { body { background: #fff; } .profile { max-width: none; margin: 0; padding: 0; box-shadow: none; } .profile-section { break-inside: auto; } .claims li { break-inside: avoid; } }
  @media (max-width: 620px) { .profile { margin: 0; padding: 24px 20px; } .profile-header h1 { font-size: 24pt; } }
</style>
</head>
<body>
<main class="profile">
<header class="profile-header">
{% if identity.get('name') %}<h1><span data-identity="name">{{ identity['name'] }}</span></h1>{% endif %}
{% for key, value in identity.items() if key != 'name' and value %}
<p class="identity-detail"><span data-identity="{{ key }}">{{ value }}</span></p>
{% endfor %}
</header>
{% for heading, claims in sections %}
<section class="profile-section">
<h2>{{ heading }}</h2>
<ul class="claims">
{% for c in claims %}
<li>{% if receipt_base %}<a class="claim-link" href="{{ receipt_base }}/{{ c.claim_id | urlencode }}?plan_id={{ plan_id | urlencode }}">{% endif %}<span data-claim-id="{{ c.claim_id }}" data-claim-version="{{ c.version }}">{{ c.text }}</span>{% if receipt_base %}</a>{% endif %}</li>
{% endfor %}
</ul>
</section>
{% endfor %}
<footer>{{ copy.marker }}</footer>
</main>
<dialog class="receipt-popover" id="receipt-popover" aria-label="Evidence receipt"><div class="popover-content"></div></dialog>
<script src="/static/app.js" defer></script>
</body>
</html>
