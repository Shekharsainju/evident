<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>{{ job.title }}</title>
<style>
  body { margin: 0; font-family: Arial, Helvetica, sans-serif; background: #f3f4f6; color: #1f2937; }
  .bar { background: #0f766e; color: #fff; padding: 14px 32px; font-size: 18px; font-weight: bold; }
  .card { background: #fff; max-width: 980px; margin: 24px auto; padding: 28px 36px; border-radius: 8px; box-shadow: 0 1px 4px rgba(0,0,0,0.12); }
  h1 { margin: 0 0 6px 0; font-size: 28px; }
  .facts { color: #4b5563; margin-bottom: 18px; font-size: 15px; }
  .facts span { margin-right: 22px; }
  h2 { font-size: 18px; margin: 20px 0 8px 0; }
  p, li { font-size: 15px; line-height: 1.55; }
  .apply { display: inline-block; background: #0f766e; color: #fff; padding: 10px 22px; border-radius: 6px; margin-top: 16px; }
  footer { text-align: center; font-size: 12px; color: #6b7280; padding: 8px 0 24px 0; }
</style></head>
<body>
<div class="bar">Example Jobs Board</div>
<div class="card">
  <h1>{{ job.title }}</h1>
  <div class="facts"><span>{{ job.location }}</span><span>{{ job.job_type }}</span><span>{{ job.salary }}</span></div>
  <h2>Job description</h2>
  <p>{{ job.description }}</p>
  <h2>Benefits</h2>
  <ul>{% for b in job.benefits %}<li>{{ b }}</li>{% endfor %}</ul>
  <span class="apply">Apply now</span>
</div>
<footer>{{ marker }}</footer>
</body></html>
